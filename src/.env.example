# Copy to src/.env and fill in. Leave keys you do not use empty.

# Anthropic API key (claude-* models)
ANTHROPIC_API_KEY=

# OpenAI API key and optional custom OpenAI-compatible endpoint (openai/ models)
OPENAI_API_KEY=
OPENAI_API_BASE=

# OpenAI-compatible proxy for self-hosted / open-source models
RCHAT_OSS_API_BASE=
RCHAT_OSS_API_KEY=

# GitHub token for the source-mining scripts (raises the GitHub API rate limit; no scopes needed for public repos)
GITHUB_TOKEN=

# Azure OpenAI (optional): set all three, then use --model azure/<deployment_name>
AZURE_API_BASE=
AZURE_API_KEY=
AZURE_API_VERSION=
